PAPERMIND_ENVIRONMENT=development
PAPERMIND_API_TITLE=PaperMind API
PAPERMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clerk backend auth
# Required by FastAPI to verify Clerk session tokens.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Optional. If provided, Clerk token verification can be done without fetching
# JWKS from Clerk's API.
CLERK_JWT_KEY=

# Comma-separated frontend origins allowed by Clerk's authorized party check.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
